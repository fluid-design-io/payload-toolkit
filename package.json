{
  "name": "payload-toolkit",
  "version": "0.1.0-alpha.1",
  "description": "Install developer-owned Payload starter features with contextual agent integration",
  "homepage": "https://github.com/fluid-design-io/payload-toolkit#readme",
  "bugs": {
    "url": "https://github.com/fluid-design-io/payload-toolkit/issues"
  },
  "license": "MIT",
  "author": {
    "name": "Oliver",
    "url": "https://oliverpan.vercel.app"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/fluid-design-io/payload-toolkit.git"
  },
  "bin": {
    "payload-toolkit": "dist/cli.js"
  },
  "files": [
    "dist",
    "assets/registry",
    "catalog/bootstrap.json",
    "LICENSE.md",
    "README.md"
  ],
  "type": "module",
  "exports": {},
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/",
    "tag": "alpha"
  },
  "scripts": {
    "registry:build": "bun scripts/registry-build.ts",
    "registries:build": "bun scripts/community-registry-build.ts",
    "registries:check": "bun scripts/community-registry-build.ts --check",
    "build": "bun run registry:build && bun run registries:build && bun ./node_modules/typescript/bin/tsc -p tsconfig.build.json && bun scripts/finish-build.mjs",
    "typecheck": "bun ./node_modules/typescript/bin/tsc --noEmit -p tsconfig.json",
    "lint": "oxlint src scripts tests registry/forms && bun scripts/check-boundaries.ts",
    "format": "oxfmt --check src scripts tests registry catalog package.json tsconfig.json tsconfig.build.json",
    "format:fix": "oxfmt src scripts tests registry catalog package.json tsconfig.json tsconfig.build.json",
    "test": "bun test ./src ./tests ./scripts/fixtures",
    "check": "bun run registries:check && bun run build && bun run typecheck && bun run lint && bun run test",
    "dev": "bun src/cli.ts",
    "agent:setup": "bun scripts/agent.ts setup",
    "agent:doctor": "bun scripts/agent.ts doctor",
    "agent:verify": "bun scripts/agent.ts verify",
    "agent:evidence": "bun scripts/agent.ts evidence",
    "agent:cleanup": "bun scripts/agent.ts cleanup",
    "prepack": "bun run build"
  },
  "dependencies": {
    "@clack/prompts": "1.8.1",
    "commander": "15.0.0",
    "semver": "7.8.5",
    "shadcn": "4.21.4",
    "validate-npm-package-name": "8.0.0",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@playwright/test": "1.64.0",
    "@types/bun": "1.4.2",
    "@types/node": "24.12.3",
    "@types/semver": "7.8.0",
    "@types/validate-npm-package-name": "4.0.2",
    "oxfmt": "0.72.0",
    "oxlint": "1.87.0",
    "typescript": "6.0.3"
  },
  "engines": {
    "bun": ">=1.4.2"
  },
  "packageManager": "bun@1.4.2",
  "trustedDependencies": []
}
