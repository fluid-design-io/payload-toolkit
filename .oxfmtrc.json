{
  "$schema": "./node_modules/oxfmt/configuration_schema.json",
  "useTabs": false,
  "tabWidth": 2,
  "printWidth": 100,
  "singleQuote": true,
  "semi": false,
  "ignorePatterns": [
    "node_modules",
    "dist",
    "assets",
    ".scratch",
    ".agents",
    ".claude",
    ".cursor",
    "docs"
  ]
}
